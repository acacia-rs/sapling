+/// TRACE: `SAPLING_TRACE_RULES=<substring>` prints matching rules' feature positions and writes.
+pub(crate) fn trace_on(rule: &str) -> bool {
+    static PAT: std::sync::OnceLock<Option<String>> = std::sync::OnceLock::new();
+    if rule.is_empty() {
+        return TRACING.with(|t| t.get());
+    }
+    let on = PAT.get_or_init(|| std::env::var("SAPLING_TRACE_RULES").ok()).as_deref().is_some_and(|p| rule.contains(p));
+    TRACING.with(|t| t.set(on));
+    on
+}
+
+thread_local! {
+    static TRACING: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
